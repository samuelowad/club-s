{
  "name": "server",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "dev": "nodemon --watch 'src/**/*.ts' --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prod": "npm run build && npm run start",
    "migration:create": "npx typeorm migration:create ./src/database/migrations/$npm_config_name",
    "migration:generate": "npx typeorm migration:generate -d src/database/index.ts -n",
    "migration:run": "node --loader ts-node/esm -r ts-node/register ./node_modules/typeorm/cli.js migration:run -d src/database/index.ts",
    "miration:run-ts": "npx typeorm migration:run -d src/database/index.ts",
    "migration:revert": "node --loader ts-node/esm -r ts-node/register ./node_modules/typeorm/cli.js migration:revert -d src/database/index.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@avallone-io/rls": "^2.0.4",
    "amqplib": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  }
}
